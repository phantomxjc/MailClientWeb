#!/bin/bash
# 星尘邮箱 —— 升级前执行
#
# 数据都在 shares 目录里，升级不动它；这里只确认 docker 可用。

LOG_DIR="${TRIM_PKGVAR}"
[ -d "$LOG_DIR" ] || LOG_DIR="/tmp"
LOG_FILE="${LOG_DIR}/build.log"
log () { echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"; }

log "===== upgrade_init 开始 ====="

if ! command -v docker >/dev/null 2>&1; then
    log "检查失败：未找到 docker 命令，中止升级"
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "未检测到 Docker，无法升级。请先确认 Docker 服务正常。" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
fi

log "docker 可用，准备升级（数据目录不受影响）"
exit 0
